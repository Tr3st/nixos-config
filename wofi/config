# ==========================================
# WOFI - CONFIGURAZIONE PRO (CAELESTIA)
# ==========================================

# -- Aspetto Generale --
show=drun
prompt=Cerca applicazione...
width=400
height=300
location=center

# -- Comportamento e Ricerca --
insensitive=true        # Ignora le maiuscole/minuscole
allow_images=true       # Abilita le icone GTK
image_size=32           # Icone leggermente più grandi (da 30 a 32 per allineamento a griglia)
hide_scroll=true        # Barra laterale nascosta per massima pulizia
no_actions=true         # Rimuove doppioni inutili

# -- Integrazione Sistema --
term=kitty              
always_parse_args=true
allow_markup=true
