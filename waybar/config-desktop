{
    "layer": "top",
    "position": "top",
    "height": 28,
    "spacing": 8,
    "margin-top": 6,
    "margin-left": 12,
    "margin-right": 12,

    "modules-left": ["hyprland/workspaces"],
    "modules-center": ["clock"],
    "modules-right": ["cpu", "memory", "pulseaudio", "tray", "custom/power"],

    "hyprland/workspaces": {
        "format": "{icon}",
        "format-icons": { "active": "", "default": "" }
    },

    "clock": {
        "format": "  {:%H:%M     %d %b}",
        "tooltip": false
    },

    "cpu": { "format": "  {usage}%", "tooltip": false },
    "memory": { "format": "  {percentage}%", "tooltip": false },

    "pulseaudio": {
        "format": "{icon}  {volume}%",
        "format-muted": "  Muted",
        "format-icons": { "default": ["", "", ""] },
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "tooltip": false
    },

    "tray": { "spacing": 8 },

    "custom/power": {
        "format": "",
        "on-click": "systemctl poweroff",
        "on-click-right": "systemctl reboot",
        "tooltip-format": "Click sx: Spegni | Click dx: Riavvia"
    }
}
